[node name="TutorialTrigger3" type="Area2D" parent="." unique_id=1064705673]
position = Vector2(18336, 1374)
collision_mask = 64
script = ExtResource("36_q4oe8")
messages = Array[String](["不知道你是否注意到沿途的隐藏道具，偶尔你需要离开光去冒险收集收藏品！也许都收集了会触发意想不到的结局~", "这些收集物的获取都需要离开光，因此需要大胆冒风险主动离开光去尝试！", "由于一开始需要摸索，也许需要多次尝试来决策路线~可以ESC后按R按钮来快速重启本关或是进入下一关前决定是否重启！"])

