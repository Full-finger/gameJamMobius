[node name="TutorialTrigger1" type="Area2D" parent="." unique_id=934683876]
collision_mask = 64
script = ExtResource("36_q4oe8")
messages = Array[String](["A/D移动，空格跳跃，ESC开启菜单以便重开和游戏设置，R键快速重开", "追上光！否则就会\"迟暮\"，受到越来越强的减速和减跳跃，右上角是你离开光后的\"余晖\",当其耗尽就会死亡！", "一旦掉落或跟不上光几乎就是慢性死亡了~所以善用R键快速重开~"])

